{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "minimumReleaseAge": "7 days",
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "semanticCommitType": "fix"
  },
  "packageRules": [
    {
      "description": "What ends up in the APK or the web UI bundle is a fix, so its update leads to a patch release; tools and tests stay chore",
      "matchPackageNames": [
        "com.squareup.okhttp3:okhttp",
        "org.nanohttpd:nanohttpd",
        "org.jetbrains.kotlinx:kotlinx-serialization-json",
        "com.android.tools:desugar_jdk_libs",
        "svelte"
      ],
      "semanticCommitType": "fix"
    },
    {
      "matchDepNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Kotlin, serialization and coroutines together, otherwise compiler and libraries do not fit",
      "matchPackageNames": [
        "org.jetbrains.kotlin{/,}**",
        "org.jetbrains.kotlinx{/,}**"
      ],
      "groupName": "Kotlin",
      "semanticCommitType": "fix"
    },
    {
      "description": "Android Gradle Plugin and desugaring together; majors only after approval. A Gradle plugin matches by its package name <id>:<id>.gradle.plugin, not by its id",
      "matchPackageNames": [
        "com.android.tools.build:gradle",
        "com.android.application:com.android.application.gradle.plugin",
        "com.android.tools:desugar_jdk_libs"
      ],
      "groupName": "Android Gradle Plugin",
      "semanticCommitType": "fix"
    },
    {
      "matchPackageNames": [
        "com.android.tools.build:gradle",
        "com.android.application:com.android.application.gradle.plugin"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Web UI tools (lint, format, types, build, tests) bundled, except majors",
      "matchFileNames": [
        "webadmin/package.json"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Web UI tools"
    },
    {
      "description": "Svelte is in the web UI bundle: its own fix PR, apart from the Web UI tools (after their rule, later rules win)",
      "matchPackageNames": [
        "svelte"
      ],
      "groupName": "Svelte"
    },
    {
      "description": "Playwright changes the browsers, own PR",
      "matchPackageNames": [
        "@playwright/test"
      ],
      "groupName": "Playwright"
    },
    {
      "description": "openapi-typescript and typescript-eslint need TypeScript 5",
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "JDK stays on 17 (Gradle toolchain and Android)",
      "matchPackageNames": [
        "java"
      ],
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The mise version that jdx/mise-action installs in the workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/(ci|openspec-drift|release-please|renovate-artifacts)\\.yml$/"
      ],
      "matchStrings": [
        "MISE_VERSION: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/mise",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}

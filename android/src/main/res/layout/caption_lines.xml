<?xml version="1.0" encoding="utf-8"?>
<!-- One of the two caption views of CaptionOverlay: album title and comment, and the place below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:alpha="0"
    android:orientation="vertical">

    <TextView
        android:id="@+id/caption_line"
        style="@style/FrameText.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2" />

    <TextView
        android:id="@+id/caption_place"
        style="@style/FrameText.Caption.Place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />
</LinearLayout>

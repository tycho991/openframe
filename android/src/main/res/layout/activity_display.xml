<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frame_background"
    android:keepScreenOn="true">

    <ImageView
        android:id="@+id/photo_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/photo_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/loading"
        style="@style/FrameText.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/loading"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/empty_title"
            style="@style/FrameText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_title" />

        <TextView
            android:id="@+id/empty_body"
            style="@style/FrameText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="640dp" />

        <TextView
            android:id="@+id/empty_code_label"
            style="@style/FrameText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/pairing_code" />

        <TextView
            android:id="@+id/empty_code"
            style="@style/FrameText.Code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="28dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock_time"
            style="@style/FrameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/clock_date"
            style="@style/FrameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/frame_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="28dp"
        android:paddingTop="18dp"
        android:paddingRight="28dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hint_name"
                style="@style/FrameText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/hint_address"
                style="@style/FrameText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hint_code_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/FrameText.Body"
                android:id="@+id/hint_code_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pairing_code"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/hint_code"
                style="@style/FrameText.Code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="34sp" />
        </LinearLayout>

        <Button
            android:id="@+id/hint_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>

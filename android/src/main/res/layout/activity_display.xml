<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frame_background"
    android:keepScreenOn="true">

    <ImageView
        android:id="@+id/photo_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/photo_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/loading"
        style="@style/FrameText.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/loading"
        android:textColor="@color/ds_muted"
        android:visibility="gone" />

    <!-- Text column and QR code; DisplayActivity puts them side by side in landscape, the QR code on top in portrait. -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/ds_space_6"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/empty_title"
                style="@style/FrameText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_title"
                android:textColor="@color/ds_text" />

            <TextView
                android:id="@+id/empty_body"
                style="@style/FrameText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_3"
                android:gravity="center"
                android:maxWidth="@dimen/frame_empty_body_max_width"
                android:textColor="@color/ds_muted" />

            <TextView
                android:id="@+id/empty_code_label"
                style="@style/FrameText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/frame_edge"
                android:text="@string/pairing_code"
                android:textColor="@color/ds_muted" />

            <TextView
                android:id="@+id/empty_code"
                style="@style/FrameText.Code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_qr"
            style="@style/FrameQr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ds_muted" />
    </LinearLayout>

    <!-- Two caption views that cross-fade with the photo (CaptionOverlay); its corner and alignment come from the
         settings. -->
    <FrameLayout
        android:id="@+id/caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_margin="@dimen/frame_edge"
        tools:ignore="RtlHardcoded">

        <include
            android:id="@+id/caption_a"
            layout="@layout/caption_lines" />

        <include
            android:id="@+id/caption_b"
            layout="@layout/caption_lines" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/frame_edge"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock_time"
            style="@style/FrameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/clock_date"
            style="@style/FrameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Row with name, address, code and pause. DisplayActivity puts the QR code at the end of the row in landscape,
         above it in portrait; that is why the hint is not a useless parent. -->
    <LinearLayout
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/frame_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/frame_edge"
        android:paddingTop="@dimen/frame_hint_padding_vertical"
        android:paddingRight="@dimen/frame_edge"
        android:paddingBottom="@dimen/frame_hint_padding_vertical"
        android:visibility="gone"
        tools:ignore="UselessParent">

        <LinearLayout
            android:id="@+id/hint_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hint_name"
                    style="@style/FrameText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/frame_hint_name" />

                <TextView
                    android:id="@+id/hint_address"
                    style="@style/FrameText.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hint_code_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ds_space_5"
                android:layout_marginRight="@dimen/ds_space_5"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/FrameText.Body"
                    android:id="@+id/hint_code_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pairing_code"
                    android:textSize="@dimen/ds_text_body" />

                <TextView
                    android:id="@+id/hint_code"
                    style="@style/FrameText.Code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/frame_hint_code" />
            </LinearLayout>

            <Button
                android:id="@+id/hint_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/frame_pause_min_width"
                android:textSize="@dimen/ds_text_title" />

            <TextView
                android:id="@+id/hint_qr"
                style="@style/FrameQr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- Above everything during a dark wake, when the display is on only to get the network back. -->
    <View
        android:id="@+id/dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</FrameLayout>

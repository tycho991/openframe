<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared look on the frame: black background, light text with a shadow, calm accent color. -->
    <color name="frame_background">#000000</color>
    <color name="frame_text">#FFFFFFFF</color>
    <color name="frame_text_muted">#CCFFFFFF</color>
    <color name="frame_accent">#FF5FB39B</color>
    <color name="frame_panel">#B3101010</color>
    <color name="frame_shadow">#B3000000</color>

    <style name="Theme.OpenFrame" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/frame_background</item>
        <item name="android:colorAccent">@color/frame_accent</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.OpenFrame.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/frame_accent</item>
    </style>

    <style name="FrameText">
        <item name="android:textColor">@color/frame_text</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:shadowColor">@color/frame_shadow</item>
        <item name="android:shadowRadius">6</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
    </style>

    <style name="FrameText.Title">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="FrameText.Body">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/frame_text_muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Pairing QR code as the top drawable, with "Scan with your phone" below it. -->
    <style name="FrameQr" parent="FrameText.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:layout_margin">12dp</item>
        <item name="android:text">@string/qr_scan</item>
    </style>

    <!-- The caption over the photo: the clock's shadow, so it reads on bright and dark photos. -->
    <style name="FrameText.Caption">
        <item name="android:textSize">22sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="FrameText.Caption.Place">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/frame_text_muted</item>
    </style>

    <style name="FrameText.Code">
        <item name="android:textSize">44sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textColor">@color/frame_accent</item>
    </style>
</resources>

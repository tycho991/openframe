<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Asking for the Wi-Fi again while the display is off (WifiManager.reconnect, startScan); a normal permission. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Updates through Android's installation dialog; a normal permission that takes effect from API 26. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android's system brightness (spec `display-brightness`): granted with the installation up to API 22, allowed by the
         user in "Modify system settings" from API 23. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- From API 30 the package manager shows other apps only when they are declared here (spec `kiosk-host`, "Android
         settings from the device menu"): the Frameo's frame app for the firmware check, and Android's settings for the
         device menu's entry. -->
    <queries>
        <package android:name="net.frameo.frame" />
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".android.FrameApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenFrame"
        android:usesCleartextTraffic="true"
        tools:targetApi="23">
        <!-- Plain http to a Nextcloud address that the user entered on purpose, also from Android 9 on (spec
             `nextcloud-source`, "Plain http on every Android version"). The updater refuses http in its own code. -->

        <!-- HOME launcher: the Home button leads to the slideshow. -->
        <activity
            android:name=".android.DisplayActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|locale|layoutDirection|uiMode"
            android:excludeFromRecents="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true">
            <!-- Android 16 ignores the orientation on large screens for apps that target 36; this opts out
                 (spec `slideshow-display`, Orientation of the frame). The opt-out ends with targetSdk 37: before
                 that bump the render size has to follow the real window (ManifestTest guards it). Ignored below
                 Android 12. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".android.FrameService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Digital photo frame: local web server for managing photos in the home network" />
        </service>

        <!-- Decoding of photos in a process of its own: a native crash there ends neither display nor server. -->
        <service
            android:name=".android.DecoderService"
            android:exported="false"
            android:process=":decode" />

        <receiver
            android:name=".android.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- After Android replaced the app with a new version: service and display start again. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Results of the installation sessions of an update; only the system answers through the session's intent. -->
        <receiver
            android:name=".android.InstallStatusReceiver"
            android:exported="false" />

        <!-- Device administration, only to switch the display off (policy force-lock). -->
        <receiver
            android:name=".android.DisplayAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

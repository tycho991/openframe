# Dependencies run no install scripts (preinstall, install, postinstall): not in `npm ci` here, not in the Gradle
# build, not in CI. Scripts started with `npm run` or `npm test` still run, but without pre- and post-scripts. A
# package that really needs its install script has to be built explicitly with
# `npm rebuild --ignore-scripts=false <package>` (a plain `npm rebuild` obeys this setting as well).
ignore-scripts=true

{
  "name": "openframe-webadmin",
  "private": true,
  "version": "0.4.4",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/lib/api/schema.d.ts",
    "build": "npm run gen:api && vite build",
    "preview": "vite preview",
    "typecheck": "npm run gen:api && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check . && redocly lint ../api/openapi.yaml --config ../redocly.yaml",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.72.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
